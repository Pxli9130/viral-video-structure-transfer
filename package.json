{
  "name": "viral-video-structure-transfer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/shared",
    "packages/renderer",
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "dev": "npm run build --workspace @vvst/shared && npm run build --workspace @vvst/renderer && concurrently -k -n api,web -c cyan,green \"npm run dev --workspace @vvst/api\" \"npm run dev --workspace @vvst/web\"",
    "dev:api": "npm run dev --workspace @vvst/api",
    "dev:web": "npm run dev --workspace @vvst/web",
    "lint": "npm run typecheck --workspaces",
    "seed:demo": "npm run build --workspace @vvst/shared && node scripts/seed-demo.mjs",
    "demo:seed": "npm run seed:demo",
    "validate:schemas": "npm run build --workspace @vvst/shared && node scripts/validate-schemas.mjs",
    "validate:schemas:v5": "npm run build --workspace @vvst/shared && node scripts/validate-v5-contracts.mjs",
    "v5:golden": "npm run build --workspace @vvst/shared && node node_modules/.bin/tsx scripts/run-v5-golden.ts",
    "test": "npm run build --workspace @vvst/shared && npm run build --workspace @vvst/renderer && npm run test --workspace @vvst/shared && npm run test --workspace @vvst/api",
    "test:marketing": "npm run build --workspace @vvst/shared && npm run build --workspace @vvst/renderer && npm run build --workspace @vvst/api && npm run test --workspace @vvst/shared -- src/__tests__/marketingPosterCase.test.ts && node scripts/run-marketing-poster-case.mjs",
    "test:unit": "npm run test --workspace @vvst/shared",
    "test:e2e": "npm run build --workspace @vvst/shared && npm run build --workspace @vvst/renderer && npm run test --workspace @vvst/api",
    "pipeline:full": "node scripts/run-full-pipeline.mjs",
    "demo:product": "node scripts/generate-product-demo-page.mjs",
    "regression:corpus": "node scripts/run-corpus-regression.mjs",
    "regression:corpus:refresh": "node scripts/run-corpus-regression.mjs --refresh-corpus",
    "regression:corpus:strict": "node scripts/run-corpus-regression.mjs --strict",
    "eval:render-quality": "node scripts/evaluate-render-quality.mjs",
    "eval:model-understanding": "node scripts/evaluate-model-understanding.mjs",
    "eval:model-routes": "node scripts/evaluate-model-routes.mjs --offline",
    "e2e:editing-beatcut": "node scripts/run-editing-beatcut-e2e.mjs",
    "full-loop:editing": "node scripts/run-full-loop-editing-artifacts.mjs",
    "demo:final": "node scripts/run-demo-final.mjs",
    "learn:samples": "node scripts/run-learn-samples.mjs",
    "learn:max-ability:four": "node scripts/run-max-ability-four-samples.mjs",
    "render:case": "node scripts/render-case.mjs",
    "showcase:report": "node scripts/export-showcase-report.mjs",
    "submission:pack": "node scripts/export-submission-artifacts.mjs",
    "visual:qa": "node scripts/visual-qa-report.mjs --all-cases",
    "remotion:verify-host": "node scripts/verify-remotion-host.mjs --case marketing",
    "elevenlabs:verify": "node scripts/verify-elevenlabs.mjs",
    "heavy:ml:audit": "node scripts/audit-heavy-model-usage.mjs --offline --json",
    "gates:final": "node scripts/evaluate-final-gates.mjs",
    "eval:render-diversity": "node -e \"const {spawnSync}=require('node:child_process');const py=process.env.CONDA_BASE?`${process.env.CONDA_BASE}/envs/${process.env.VIRAL_CONDA_ENV||'viral'}/bin/python`:'python3';process.exit(spawnSync(py,['scripts/diversity_ncc.py',...process.argv.slice(1)],{stdio:'inherit'}).status||0)\" --",
    "analyze:evidence": "node -e \"const {spawnSync}=require('node:child_process');const a=process.argv.slice(1);const py=process.env.CONDA_BASE?`${process.env.CONDA_BASE}/envs/${process.env.VIRAL_CONDA_ENV||'viral'}/bin/python`:'python3';process.exit(spawnSync(py,['scripts/analyze-evidence-timeline.py',...a],{stdio:'inherit'}).status||0)\" --",
    "corpus:generate": "node -e \"const {spawnSync}=require('node:child_process');const r=spawnSync(process.env.CONDA_BASE? `${process.env.CONDA_BASE}/envs/${process.env.VIRAL_CONDA_ENV||'viral'}/bin/python` : 'python3', ['scripts/generate-synthetic-corpus.py','--root','test_videos/corpus'],{stdio:'inherit'});process.exit(r.status||0)\"",
    "typecheck": "npm run build --workspace @vvst/shared && npm run build --workspace @vvst/renderer && npm run typecheck --workspaces"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
