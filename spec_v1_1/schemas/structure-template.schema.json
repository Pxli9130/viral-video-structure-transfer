{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://viral-video-structure-transfer.local/schemas/structure-template.schema.json",
  "title": "StructureTemplate",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "vertical",
    "sourceExample",
    "summary",
    "segments",
    "packaging",
    "rhythm",
    "qualityRules",
    "structureAtoms",
    "editingTechniques",
    "sourcePolicy"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "projectId": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "vertical": {
      "type": "string",
      "enum": [
        "b2b_marketing_mg",
        "vlog",
        "talking_head",
        "cutting_beat",
        "short_drama",
        "generic"
      ]
    },
    "sourceExample": {
      "$ref": "#/$defs/sourceExample"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "targetDurationSec": {
      "type": "number",
      "minimum": 1
    },
    "aspectRatio": {
      "type": "string",
      "enum": ["9:16", "16:9", "1:1", "4:5"]
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/segment"
      }
    },
    "packaging": {
      "$ref": "#/$defs/packaging"
    },
    "rhythm": {
      "$ref": "#/$defs/rhythm"
    },
    "qualityRules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/qualityRule"
      }
    },
    "structureAtoms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/structureAtom"
      }
    },
    "editingTechniques": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/editingTechnique"
      }
    },
    "qualityRationale": {
      "type": "string"
    },
    "replacementPolicy": {
      "$ref": "#/$defs/replacementPolicy"
    },
    "sourcePolicy": {
      "$ref": "#/$defs/sourcePolicy"
    },
    "createdAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    }
  },
  "$defs": {
    "sourceExample": {
      "type": "object",
      "required": ["assetId", "durationSec"],
      "additionalProperties": false,
      "properties": {
        "assetId": { "type": "string" },
        "filename": { "type": "string" },
        "durationSec": { "type": "number", "minimum": 0 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "fps": { "type": "number", "minimum": 0 },
        "thumbnailPath": { "type": "string" }
      }
    },
    "segment": {
      "type": "object",
      "required": ["id", "role", "startSec", "endSec", "intent", "shots", "requiredSlots"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "role": {
          "type": "string",
          "enum": ["hook", "body", "proof", "transition", "cta", "other"]
        },
        "startSec": { "type": "number", "minimum": 0 },
        "endSec": { "type": "number", "minimum": 0 },
        "intent": { "type": "string" },
        "pacing": {
          "type": "string",
          "enum": ["slow", "medium", "fast", "variable"]
        },
        "sourceRationale": { "type": "string" },
        "requiredSlots": {
          "type": "array",
          "items": { "$ref": "#/$defs/slot" }
        },
        "shots": {
          "type": "array",
          "items": { "$ref": "#/$defs/shot" }
        },
        "packagingRefs": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "shot": {
      "type": "object",
      "required": ["id", "startSec", "endSec", "shotType", "visualIntent"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "startSec": { "type": "number", "minimum": 0 },
        "endSec": { "type": "number", "minimum": 0 },
        "shotType": {
          "type": "string",
          "enum": [
            "product_closeup",
            "usage_scene",
            "comparison",
            "lifestyle_scene",
            "text_card",
            "background",
            "cta",
            "unknown"
          ]
        },
        "visualIntent": { "type": "string" },
        "motion": { "type": "string" },
        "transitionIn": { "type": "string" },
        "transitionOut": { "type": "string" },
        "textOverlay": { "type": "string" }
      }
    },
    "slot": {
      "type": "object",
      "required": ["id", "slotType", "required", "description"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "slotType": {
          "type": "string",
          "enum": [
            "hook_visual",
            "product_closeup",
            "usage_scene",
            "comparison_scene",
            "proof_visual",
            "cta_visual",
            "text_or_subtitle",
            "background",
            "other"
          ]
        },
        "required": { "type": "boolean" },
        "description": { "type": "string" },
        "preferredAssetTags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "fallbackAllowed": { "type": "boolean" }
      }
    },
    "packaging": {
      "type": "object",
      "required": ["style", "subtitle", "cards", "transitions"],
      "additionalProperties": false,
      "properties": {
        "style": {
          "type": "string",
          "enum": ["clean", "bold", "mg_motion", "cinematic", "ugc", "generic"]
        },
        "subtitle": {
          "type": "object",
          "required": ["density", "position"],
          "additionalProperties": false,
          "properties": {
            "density": { "type": "string", "enum": ["low", "medium", "high"] },
            "position": { "type": "string" },
            "fontHint": { "type": "string" },
            "safeArea": { "type": "string" }
          }
        },
        "cards": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "purpose", "style"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "purpose": { "type": "string" },
              "style": { "type": "string" }
            }
          }
        },
        "stickers": {
          "type": "array",
          "items": { "type": "string" }
        },
        "transitions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "coverSuggestion": { "type": "string" }
      }
    },
    "rhythm": {
      "type": "object",
      "required": ["averageShotDurationSec", "pace", "climaxPosition"],
      "additionalProperties": false,
      "properties": {
        "averageShotDurationSec": { "type": "number", "minimum": 0 },
        "pace": { "type": "string", "enum": ["slow", "medium", "fast", "variable"] },
        "climaxPosition": { "type": "string" },
        "beatNotes": { "type": "string" }
      }
    },
    "qualityRule": {
      "type": "object",
      "required": ["id", "rule", "reason"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "rule": { "type": "string" },
        "reason": { "type": "string" },
        "severity": { "type": "string", "enum": ["info", "warning", "critical"] }
      }
    },
    "structureAtom": {
      "type": "object",
      "required": ["id", "role", "name", "description", "applicableWhen"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "role": { "type": "string", "enum": ["hook", "body", "proof", "transition", "cta", "packaging"] },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "applicableWhen": { "type": "string" },
        "requiresSlots": {
          "type": "array",
          "items": { "type": "string" }
        },
        "replacementPolicy": { "type": "string" },
        "sourceSegmentIds": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "editingTechnique": {
      "type": "object",
      "required": ["id", "name", "description"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "params": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "replacementPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowSourceVideoReuse": { "type": "boolean" },
        "allowTextCardSubstitution": { "type": "boolean" },
        "allowAigcPlaceholder": { "type": "boolean" },
        "notes": { "type": "string" }
      }
    },
    "sourcePolicy": {
      "type": "object",
      "required": ["sampleSource", "commercialUse", "doNotCopyOriginalContent"],
      "additionalProperties": false,
      "properties": {
        "sampleSource": {
          "type": "string",
          "enum": ["open_download_or_user_uploaded", "user_authorized", "demo_only", "unknown"]
        },
        "commercialUse": { "type": "boolean" },
        "doNotCopyOriginalContent": { "type": "boolean" },
        "notes": { "type": "string" }
      }
    }
  }
}
