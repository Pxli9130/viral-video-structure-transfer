# Viral Video Structure Transfer Engine
# Copy this file to .env and fill in provider credentials locally.
# Keep real API keys out of git.

# ---- Server ----
APP_PORT=3000
WEB_PORT=5173
STORAGE_DIR=./storage

# ---- Adapter selection ----
VIDEO_TOOL=ffmpeg
# Options: gemini | ark_doubao | openai_compatible
AI_PROVIDER=gemini
AI_GEMINI_MODEL=gemini-3.5-flash
GEMINI_CODEGEN_MODEL=gemini-3.5-flash
RENDERER=html_preview
STORAGE_BACKEND=json

# ---- Volcano Ark / Doubao text model ----
# Select with AI_PROVIDER=ark_doubao after providing a valid ARK_API_KEY.
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=
ARK_MODEL=ep-20260508213828-7ntjl

# ---- Conda viral env and local media tools ----
CONDA_BASE=/home/pxli/anaconda3
VIRAL_CONDA_ENV=viral
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ---- Gemini VLM / text / Gen1 capsule models ----
VLM_PROVIDER=gemini
VLM_MODEL=gemini-3.5-flash
GEMINI_API_KEY=
GEMINI_GEN1_MODEL=gemini-3.1-pro-preview
GEMINI_GEN1_MODEL_LONG=gemini-3.1-pro-preview
GEMINI_GEN1_PRO_MIN_SEC=34

# ---- Optional Python adapters installed in conda viral ----
# ASR_PROVIDER: elevenlabs_scribe | faster_whisper
ASR_PROVIDER=elevenlabs_scribe
ASR_MODEL=tiny
# OCR_PROVIDER: easyocr or empty to disable
OCR_PROVIDER=easyocr

# ---- Remotion renderer overrides ----
REMOTION_ENTRY=
REMOTION_COMPOSITION_ID=ViralReconstruction

# ---- AIGC image material fill ----
AIGC_MATERIAL_FILL_ENABLED=true
AIGC_IMAGE_PROVIDER=google_gemini_image
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
AIGC_IMAGE_BACKUP_PROVIDER=volcengine_seedream
AIGC_IMAGE_MODEL=doubao-seedream-5-0-260128
AIGC_IMAGE_RESPONSE_FORMAT=url
AIGC_IMAGE_SIZE=2K
AIGC_IMAGE_WATERMARK=false

# ---- Seedream backup image provider ----
SEEDREAM_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SEEDREAM_ARK_API_KEY=
SEEDREAM_ARK_MODEL=doubao-seedream-5-0-260128
SEEDREAM_IMAGE_ENDPOINT=/images/generations
SEEDREAM_SEQUENTIAL_IMAGE_GENERATION=disabled
SEEDREAM_RESPONSE_FORMAT=url
SEEDREAM_IMAGE_SIZE=2K
SEEDREAM_STREAM=false
SEEDREAM_WATERMARK=false

# ---- Optional video material provider ----
AIGC_VIDEO_PROVIDER=seedance_2_0
AIGC_VIDEO_MODEL=doubao-seedance-2-0-fast-260128
SEEDANCE_MODEL=doubao-seedance-2-0-fast-260128
AIGC_VIDEO_FILL=1

# ---- Video backup provider: DashScope happyhorse-1.0-r2v ----
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope-us.aliyuncs.com/api/v1
AIGC_VIDEO_BACKUP_PROVIDER=happyhorse_r2v
HAPPYHORSE_MODEL=happyhorse-1.0-r2v
HAPPYHORSE_RESOLUTION=720P

# ---- Audio generation defaults ----
# Runtime order: Google audio -> ElevenLabs -> local FFmpeg/procedural fallback.
GOOGLE_AUDIO_ENABLE_CLOUD=1
GOOGLE_AUDIO_ENABLE_TTS=1
GOOGLE_AUDIO_ENABLE_MUSIC=1
GOOGLE_TTS_MODEL=gemini-3.1-flash-tts-preview
GOOGLE_TTS_VOICE=Kore
GOOGLE_MUSIC_MODEL=lyria-3-clip-preview

# ---- Privacy / safety gates ----
AIGC_ALLOW_EXTERNAL_UPLOAD=true
AIGC_ALLOW_SAMPLE_FRAMES_TO_PROVIDER=true
AIGC_ALLOW_TARGET_ASSETS_TO_PROVIDER=true
ELEVENLABS_API_KEY=
ENABLE_ELEVENLABS_LIVE_TESTS=1

# ---- Max-ability cloud switches ----
ELEVENLABS_ENABLE_CLOUD=1
ELEVENLABS_ENABLE_MUSIC=1
ELEVENLABS_ENABLE_SFX=1
ELEVENLABS_ENABLE_TTS=1
ELEVENLABS_ENABLE_SCRIBE=1
ELEVENLABS_ENABLE_DISCOVERY=1
ELEVENLABS_ENABLE_AUDIO_ISOLATION=1
ELEVENLABS_ENABLE_FORCED_ALIGNMENT=1
ALLOW_CLOUD_PROVIDERS=1
ALLOW_EXTERNAL_SAMPLE_MEDIA=1
ALLOW_EXTERNAL_VLM_SAMPLE_ANALYSIS=1
ALLOW_EXTERNAL_VLM_USER_ASSET_ANALYSIS=1
ALLOW_EXTERNAL_ASR_SAMPLE_ANALYSIS=1
SEEDANCE_GENERATE_AUDIO=true
SEEDANCE_WATERMARK=false
AIGC_VIDEO_GENERATE_AUDIO=true
AIGC_VIDEO_MAX_ASSETS_PER_RUN=1

# ---- Optional compatibility knobs supported by code but not enabled above ----
# FFMPEG_FONT_FILE=
# OPENAI_COMPATIBLE_BASE_URL=
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_MODEL=
# AIGC_ALLOW_SAMPLE_AUDIO_TO_PROVIDER=false
# AIGC_ALLOW_SAMPLE_VIDEO_TO_PROVIDER=false
# SEEDANCE_ARK_API_KEY=
# SEEDANCE_TASK_ENDPOINT=/contents/generations/tasks
# SEEDANCE_DURATION_SEC=6
# SEEDANCE_RATIO=9:16
# SEEDANCE_MAX_POLLS=120
# SEEDANCE_POLL_INTERVAL_MS=5000
