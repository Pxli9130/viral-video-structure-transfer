# Spec v1.2 — Viral Video Structure Transfer Engine
# Copy to .env and adjust. Real provider keys are optional; mock mode runs end-to-end.

# ---- Server ----
APP_PORT=3000
WEB_PORT=5173
STORAGE_DIR=./storage

# ---- Adapter selection ----
# VIDEO_TOOL: "mock" (deterministic, no FFmpeg) or "ffmpeg" (real ffprobe + keyframes via conda viral)
VIDEO_TOOL=ffmpeg
# AI_PROVIDER: "mock" (deterministic fallback) or "openai_compatible" (requires key below)
AI_PROVIDER=mock
RENDERER=html_preview

# ---- Conda viral env (FFmpeg, ffprobe, optional Python ASR/OCR/VLM helpers) ----
CONDA_BASE=/home/pxli/anaconda3
VIRAL_CONDA_ENV=viral
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ---- Optional Python adapters (require extra pip installs inside conda viral) ----
# ASR_PROVIDER: "" (disabled) or "faster_whisper"
ASR_PROVIDER=
ASR_MODEL=tiny
# OCR_PROVIDER: "" (disabled) or "easyocr"
OCR_PROVIDER=
# VLM_PROVIDER: "" (disabled), "heuristic" (local placeholder), or "gemini" (Google Gemini VLM)
VLM_PROVIDER=
VLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=

# ---- Paid provider placeholders (you supply if/when needed) ----
# Set AI_PROVIDER=openai_compatible and fill these to use a real LLM.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
DOUBAO_API_KEY=
DOUBAO_BASE_URL=
