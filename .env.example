# Viral Video Structure Transfer Engine
# Copy to .env and adjust. Max-ability runs are API-first when keys are configured;
# local deterministic/procedural paths are fallback, not fake provider output.

# ---- Server ----
APP_PORT=3000
WEB_PORT=5173
STORAGE_DIR=./storage

# ---- Adapter selection ----
# VIDEO_TOOL: "ffmpeg" (real ffprobe + keyframes via conda viral)
VIDEO_TOOL=ffmpeg
# AI_PROVIDER (text LLM for structure enrichment / revise / scorecard):
#   "gemini"             - Gemini text LLM (set GEMINI_API_KEY; model AI_GEMINI_MODEL).
#                          SEPARATE request from the Gemini VLM video understanding.
#   "openai_compatible"  - generic OpenAI-style endpoint (set OPENAI_COMPATIBLE_*)
#   "ark_doubao"         - Volcano Engine Ark Doubao Seed 2.0 lite (set ARK_*)
AI_PROVIDER=gemini
# AI_GEMINI_MODEL=gemini-flash-latest   # text model when AI_PROVIDER=gemini (defaults to VLM_MODEL)
RENDERER=html_preview
# STORAGE_BACKEND: "json" (single JSON file, default) or "sqlite" (better-sqlite3)
STORAGE_BACKEND=json

# ---- Conda viral env (FFmpeg, ffprobe, optional Python ASR/OCR/VLM helpers) ----
CONDA_BASE=/home/pxli/anaconda3
VIRAL_CONDA_ENV=viral
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Override the CJK font used by FFmpeg drawtext (auto-detected if blank). Without a
# CJK font, Chinese subtitles render as ▢▢▢ tofu boxes.
FFMPEG_FONT_FILE=

# ---- Optional Python adapters (require extra pip installs inside conda viral) ----
# ASR_PROVIDER: "elevenlabs_scribe" (API-first with faster-whisper fallback) or "faster_whisper"
ASR_PROVIDER=elevenlabs_scribe
ASR_MODEL=tiny
# OCR_PROVIDER: "" (disabled) or "easyocr"
OCR_PROVIDER=
# VLM_PROVIDER: "gemini" (Google Gemini VLM) or "heuristic" (local fallback only)
VLM_PROVIDER=gemini
# Recommended Google models (all on AI Studio with one GEMINI_API_KEY, separate requests each):
#   VLM_MODEL=gemini-2.5-pro            (video understanding — best fast-cut reading; or gemini-flash-latest for speed)
#   AI_GEMINI_MODEL=gemini-2.5-flash    (text LLM — structure/revise/scorecard)
#   GEMINI_IMAGE_MODEL=gemini-2.5-flash-image  (AIGC image gen, "Nano Banana", with AIGC_IMAGE_PROVIDER=google_gemini_image)
VLM_MODEL=gemini-2.5-pro
GEMINI_API_KEY=

# ---- Max-ability / cloud routing ----
# Max-ability scripts set these automatically. Keep here for manual API runs.
ALLOW_CLOUD_PROVIDERS=1
ALLOW_EXTERNAL_VLM_SAMPLE_ANALYSIS=1
ALLOW_EXTERNAL_ASR_SAMPLE_ANALYSIS=1
ALLOW_EXTERNAL_SAMPLE_MEDIA=1

# AIGC image: Google primary (Gemini native image), Ark/Seedream backup, no mock fallback.
AIGC_IMAGE_PROVIDER=google_gemini_image
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# AIGC generation must not receive sample frames/audio/video.
AIGC_ALLOW_EXTERNAL_UPLOAD=true
AIGC_ALLOW_SAMPLE_FRAMES_TO_PROVIDER=false
AIGC_ALLOW_SAMPLE_AUDIO_TO_PROVIDER=false
AIGC_ALLOW_SAMPLE_VIDEO_TO_PROVIDER=false
AIGC_ALLOW_TARGET_ASSETS_TO_PROVIDER=true
# AIGC_IMAGE_BACKUP_PROVIDER=volcengine_seedream

# ---- Paid provider credentials (you supply real values when needed) ----
# Set AI_PROVIDER=openai_compatible and fill these to use a real LLM.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

# Volcano Engine Ark Doubao Seed 2.0 lite (assets/ ships an EP + key for the contest).
# Set AI_PROVIDER=ark_doubao and copy the values from your contest packet.
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=
ARK_MODEL=

# ElevenLabs audio/ASR. Max-ability scripts enable these automatically when the key is present.
ELEVENLABS_API_KEY=
ENABLE_ELEVENLABS_LIVE_TESTS=1
ELEVENLABS_ENABLE_CLOUD=1
ELEVENLABS_ENABLE_MUSIC=1
ELEVENLABS_ENABLE_SFX=1
ELEVENLABS_ENABLE_TTS=1

# Optional Seedream backup image provider.
SEEDREAM_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SEEDREAM_ARK_API_KEY=
SEEDREAM_ARK_MODEL=
SEEDREAM_IMAGE_ENDPOINT=/images/generations

# Seedance 2.0 Fast video material provider. SEEDANCE_ARK_API_KEY may be omitted when
# SEEDREAM_ARK_API_KEY or ARK_API_KEY already contains the same Ark bearer key.
AIGC_VIDEO_PROVIDER=seedance_2_0
AIGC_VIDEO_MODEL=doubao-seedance-2-0-fast-260128
AIGC_VIDEO_MAX_ASSETS_PER_RUN=1
SEEDANCE_ARK_API_KEY=
SEEDANCE_MODEL=doubao-seedance-2-0-fast-260128
SEEDANCE_TASK_ENDPOINT=/contents/generations/tasks
SEEDANCE_GENERATE_AUDIO=true
SEEDANCE_WATERMARK=false
# Optional request overrides:
# SEEDANCE_DURATION_SEC=6
# SEEDANCE_RATIO=9:16
# SEEDANCE_MAX_POLLS=120
# SEEDANCE_POLL_INTERVAL_MS=5000

# Optional renderer extras
REMOTION_ENTRY=
REMOTION_COMPOSITION_ID=ViralReconstruction
