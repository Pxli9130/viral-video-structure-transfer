{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://viral-structure-engine.local/schemas/timeline.schema.json",
  "title": "Timeline",
  "type": "object",
  "additionalProperties": false,
  "required": ["timeline_id", "version", "canvas", "duration_ms", "clips", "explanation"],
  "properties": {
    "timeline_id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "default": "0.1" },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "fps", "background"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "fps": { "type": "integer", "minimum": 1 },
        "background": { "type": "string" }
      }
    },
    "duration_ms": { "type": "integer", "minimum": 1000 },
    "clips": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/clip" }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bgm_asset_id": { "type": "string" },
        "mode": { "type": "string", "enum": ["none", "placeholder", "user_bgm"] },
        "notes": { "type": "string" }
      }
    },
    "quality_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status"],
        "properties": {
          "name": { "type": "string" },
          "status": { "type": "string", "enum": ["pass", "warn", "fail"] },
          "message": { "type": "string" }
        }
      }
    },
    "explanation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "mapping", "gap_fill_summary"],
      "properties": {
        "summary": { "type": "string" },
        "mapping": { "type": "array", "items": { "$ref": "#/$defs/mapping" } },
        "gap_fill_summary": { "type": "string" }
      }
    }
  },
  "$defs": {
    "clip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clip_id", "segment_id", "start_ms", "end_ms", "layers", "source"],
      "properties": {
        "clip_id": { "type": "string" },
        "segment_id": { "type": "string" },
        "source_shot_id": { "type": "string" },
        "start_ms": { "type": "integer", "minimum": 0 },
        "end_ms": { "type": "integer", "minimum": 0 },
        "transition_in": { "type": "string" },
        "transition_out": { "type": "string" },
        "layers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/layer" }
        },
        "subtitle": { "type": "string" },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": { "type": "string", "enum": ["matched_asset", "weak_asset", "gap_fill", "generated_card"] },
            "asset_id": { "type": "string" },
            "fill_strategy": { "type": "string" },
            "reason": { "type": "string" }
          }
        }
      }
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layer_id", "type", "z_index"],
      "properties": {
        "layer_id": { "type": "string" },
        "type": { "type": "string", "enum": ["video", "image", "text", "shape", "overlay", "background"] },
        "asset_id": { "type": "string" },
        "text": { "type": "string" },
        "z_index": { "type": "integer" },
        "style": { "type": "object" },
        "transform": { "type": "object" }
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_segment_id", "target_clip_id", "mapping_type", "notes"],
      "properties": {
        "source_segment_id": { "type": "string" },
        "source_shot_id": { "type": "string" },
        "target_clip_id": { "type": "string" },
        "mapping_type": { "type": "string", "enum": ["direct", "adapted", "gap_filled", "reordered"] },
        "notes": { "type": "string" }
      }
    }
  }
}
