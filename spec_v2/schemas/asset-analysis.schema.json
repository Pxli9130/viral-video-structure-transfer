{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://viral-video-structure-transfer.local/schemas/asset-analysis.schema.json",
  "title": "VideoAnalysisResult",
  "type": "object",
  "required": [
    "id",
    "assetId",
    "projectId",
    "purpose",
    "metadata",
    "keyframes",
    "shots",
    "warnings",
    "analyzerMode",
    "createdAt"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "assetId": {
      "type": "string"
    },
    "projectId": {
      "type": "string"
    },
    "purpose": {
      "enum": [
        "sample",
        "source"
      ]
    },
    "metadata": {
      "type": "object",
      "required": [
        "durationSec"
      ],
      "properties": {
        "durationSec": {
          "type": "number",
          "minimum": 0
        },
        "width": {
          "type": "number",
          "minimum": 1
        },
        "height": {
          "type": "number",
          "minimum": 1
        },
        "fps": {
          "type": "number",
          "minimum": 0
        },
        "hasAudio": {
          "type": "boolean"
        },
        "codec": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "keyframes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "timeSec"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "timeSec": {
            "type": "number",
            "minimum": 0
          },
          "path": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "shots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "startSec",
          "endSec",
          "durationSec",
          "tags",
          "confidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "startSec": {
            "type": "number",
            "minimum": 0
          },
          "endSec": {
            "type": "number",
            "minimum": 0
          },
          "durationSec": {
            "type": "number",
            "minimum": 0
          },
          "thumbnailPath": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "transcript": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "startSec",
          "endSec",
          "text"
        ],
        "properties": {
          "startSec": {
            "type": "number"
          },
          "endSec": {
            "type": "number"
          },
          "text": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "ocr": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "analyzerMode": {
      "enum": [
        "mock",
        "ffmpeg",
        "ffmpeg_opencv",
        "ffmpeg_vlm_asr"
      ]
    },
    "createdAt": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
