{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://viral-video-structure-transfer.local/schemas/project.schema.json",
  "title": "Project",
  "type": "object",
  "required": [
    "id",
    "name",
    "vertical",
    "aspectRatio",
    "targetDurationSec",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "vertical": {
      "enum": [
        "b2b_marketing_mg",
        "vlog",
        "talking_head",
        "beat_cut",
        "short_drama",
        "ecommerce"
      ]
    },
    "aspectRatio": {
      "enum": [
        "9:16",
        "16:9",
        "1:1"
      ]
    },
    "targetDurationSec": {
      "type": "number",
      "minimum": 5,
      "maximum": 180
    },
    "createdAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
