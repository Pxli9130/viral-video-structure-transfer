{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://viral-video-structure-transfer.local/schemas/generation-request.schema.json",
  "title": "GenerationRequest",
  "type": "object",
  "required": [
    "projectId",
    "inputMode",
    "prompt",
    "target"
  ],
  "properties": {
    "projectId": {
      "type": "string"
    },
    "inputMode": {
      "enum": [
        "video_plus_prompt",
        "brief_assets",
        "prompt_only"
      ]
    },
    "sourceVideo": {
      "type": "object",
      "required": [
        "assetId"
      ],
      "properties": {
        "assetId": {
          "type": "string"
        },
        "analysisId": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "selectedTemplateIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "selectedAtomIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "assetId": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "targetAssets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "image",
              "video",
              "logo",
              "copy",
              "cta_info",
              "background_image"
            ]
          },
          "role": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "filename": {
            "type": "string"
          },
          "mimeType": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "object",
      "required": [
        "vertical",
        "aspectRatio",
        "targetDurationSec",
        "outputMode"
      ],
      "properties": {
        "vertical": {
          "type": "string"
        },
        "aspectRatio": {
          "enum": [
            "9:16",
            "16:9",
            "1:1"
          ]
        },
        "targetDurationSec": {
          "type": "number",
          "minimum": 5,
          "maximum": 180
        },
        "outputMode": {
          "enum": [
            "storyboard_preview",
            "mp4_render",
            "timeline_only"
          ]
        }
      },
      "additionalProperties": true
    },
    "controls": {
      "type": "object",
      "properties": {
        "pace": {
          "enum": [
            "slow",
            "medium",
            "fast"
          ]
        },
        "hookIntensity": {
          "enum": [
            "safe",
            "strong",
            "aggressive"
          ]
        },
        "packagingStyle": {
          "enum": [
            "clean",
            "bold",
            "mg_motion"
          ]
        },
        "ctaStyle": {
          "enum": [
            "soft",
            "direct"
          ]
        },
        "creativeMode": {
          "enum": [
            "explainable_demo",
            "final_creative",
            "high_fidelity_style"
          ]
        },
        "allowAigcPlaceholder": {
          "type": "boolean"
        },
        "subtitleDensity": {
          "enum": [
            "minimal",
            "medium",
            "dense"
          ]
        },
        "stylePreset": {
          "enum": [
            "sample_like",
            "clean_premium",
            "white_poster",
            "bold_mg"
          ]
        },
        "ctaTiming": {
          "enum": [
            "early",
            "default",
            "late"
          ]
        },
        "ribbon": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "constraints": {
      "type": "object",
      "properties": {
        "forbiddenWords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mustMention": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "noSampleVisualCopy": {
          "type": "boolean"
        },
        "sampleAssetReuse": {
          "enum": [
            "disabled",
            "authorized"
          ]
        }
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "inputMode": {
            "const": "video_plus_prompt"
          }
        }
      },
      "then": {
        "required": [
          "sourceVideo"
        ]
      }
    }
  ],
  "additionalProperties": false
}
