{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://viral-video-structure-transfer.local/schemas/structure-template.schema.json",
  "title": "StructureTemplate",
  "type": "object",
  "required": [
    "id",
    "projectId",
    "name",
    "vertical",
    "sourceSampleIds",
    "segments",
    "requiredSlots",
    "rhythm",
    "packaging",
    "structureAtoms",
    "editingTechniques",
    "replacementPolicy",
    "qualityRationale",
    "sourcePolicy",
    "createdAt"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "projectId": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "vertical": {
      "type": "string"
    },
    "sourceSampleIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "videoType": {
      "type": "string"
    },
    "visualStyle": {
      "type": "object",
      "properties": {
        "background": {
          "type": "string"
        },
        "layout": {
          "type": "string"
        },
        "motionAsset": {
          "type": "string"
        },
        "colorProgression": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "typography": {
          "type": "string"
        },
        "ribbonMotion": {
          "type": "object",
          "required": [
            "surfaceType",
            "pathFamily",
            "axis",
            "depthBehavior",
            "layoutRelation",
            "textRelation"
          ],
          "properties": {
            "surfaceType": {
              "enum": [
                "thin_line",
                "wide_band",
                "textured_band",
                "particle_trail"
              ]
            },
            "pathFamily": {
              "enum": [
                "vertical_helix",
                "planar_orbit",
                "diagonal_sweep",
                "horizontal_wave",
                "spiral_in",
                "wave_loop",
                "unknown"
              ]
            },
            "axis": {
              "enum": [
                "screen_y",
                "screen_z",
                "screen_x",
                "diagonal",
                "unknown"
              ]
            },
            "depthBehavior": {
              "enum": [
                "flat",
                "perspective_only",
                "front_back_crossing",
                "occlusion_with_title"
              ]
            },
            "layoutRelation": {
              "enum": [
                "around_title",
                "background_only",
                "foreground_sweep",
                "border_frame"
              ]
            },
            "textRelation": {
              "enum": [
                "text_on_ribbon",
                "near_ribbon",
                "none"
              ]
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "evidenceFrames": {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            "turns": {
              "type": "number"
            },
            "radiusX": {
              "type": "number"
            },
            "radiusZ": {
              "type": "number"
            },
            "pitchY": {
              "type": "number"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "excludeSegments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "startSec",
          "endSec",
          "reason"
        ],
        "properties": {
          "startSec": {
            "type": "number",
            "minimum": 0
          },
          "endSec": {
            "type": "number",
            "minimum": 0
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "targetDurationSec": {
      "type": "number"
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "role",
          "startRatio",
          "endRatio",
          "intent",
          "slots"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "role": {
            "enum": [
              "hook",
              "setup",
              "body",
              "proof",
              "transition",
              "cta"
            ]
          },
          "startRatio": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "endRatio": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "intent": {
            "type": "string"
          },
          "scriptPattern": {
            "type": "string"
          },
          "slots": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "recommendedDurationSec": {
            "type": "number"
          }
        },
        "additionalProperties": true
      }
    },
    "requiredSlots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "role",
          "slotType",
          "required",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "role": {
            "enum": [
              "hook",
              "setup",
              "body",
              "proof",
              "transition",
              "cta"
            ]
          },
          "slotType": {
            "enum": [
              "hook_visual",
              "product_closeup",
              "usage_scene",
              "comparison",
              "proof_visual",
              "cta_visual",
              "subtitle_text",
              "title_card",
              "transition",
              "background"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "description": {
            "type": "string"
          },
          "preferredTags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fallbackStrategies": {
            "type": "array",
            "items": {
              "enum": [
                "reuse_with_crop_zoom",
                "text_card",
                "packaging_overlay",
                "reorder_structure",
                "procedural_generation",
                "aigc_placeholder"
              ]
            }
          }
        },
        "additionalProperties": true
      }
    },
    "rhythm": {
      "type": "object",
      "required": [
        "pace",
        "averageShotDurationSec"
      ],
      "properties": {
        "pace": {
          "enum": [
            "slow",
            "medium",
            "fast",
            "mixed"
          ]
        },
        "averageShotDurationSec": {
          "type": "number"
        },
        "peakTimeRatio": {
          "type": "number"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "packaging": {
      "type": "object",
      "properties": {
        "subtitleStyle": {
          "type": "string"
        },
        "titleCardStyle": {
          "type": "string"
        },
        "overlayStyle": {
          "type": "string"
        },
        "transitionStyle": {
          "type": "string"
        },
        "coverStyle": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "structureAtoms": {
      "type": "array",
      "items": {
        "$ref": "knowledge-atom.schema.json"
      }
    },
    "editingTechniques": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "category",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "usageRules": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "replacementPolicy": {
      "type": "object",
      "properties": {
        "doNotCopySampleVisuals": {
          "type": "boolean"
        },
        "allowedTransfer": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "forbiddenTransfer": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "qualityRationale": {
      "type": "string"
    },
    "sourcePolicy": {
      "type": "object",
      "required": [
        "sampleSource",
        "commercialUse"
      ],
      "properties": {
        "sampleSource": {
          "enum": [
            "user_authorized",
            "open_download_or_user_uploaded",
            "demo_only",
            "unknown"
          ]
        },
        "commercialUse": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "createdAt": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
